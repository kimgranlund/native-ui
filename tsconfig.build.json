{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["./src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.demo.ts",
    "src/**/__tests__",
    "src/nav",
    "src/test-setup.ts",
    "src/site-entry.ts",
    "src/site-register-traits.ts",
    "src/icons/phosphor",
    "packages"
  ]
}
