{
  "name": "@nonoun/native-a2ui",
  "version": "0.2.2",
  "description": "A2UI protocol adapter with multi-session A2A support for @nonoun/native-ui",
  "license": "MIT",
  "type": "module",
  "main": "./dist/native-a2ui.js",
  "module": "./dist/native-a2ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/native-a2ui.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./css": "./dist/native-a2ui.css",
    "./adapters/direct": {
      "types": "./dist/adapters/direct-adapter.d.ts",
      "default": "./dist/native-a2ui.js"
    },
    "./adapters/a2a": {
      "types": "./dist/adapters/a2a-adapter.d.ts",
      "default": "./dist/native-a2ui.js"
    },
    "./adapters/ag-ui": {
      "types": "./dist/adapters/ag-ui-adapter.d.ts",
      "default": "./dist/native-a2ui.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "peerDependencies": {
    "@nonoun/native-ui": ">=0.5.0",
    "@ag-ui/client": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@ag-ui/client": {
      "optional": true
    }
  },
  "dependencies": {
    "@nonoun/native-codemirror": "^0.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lint": "^6.0.0"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:types",
    "build:js": "vite build",
    "build:css": "cp src/css/a2ui.css dist/native-a2ui.css",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
