{
  "name": "@nonoun/native-a2ui",
  "version": "0.1.6",
  "description": "A2UI protocol workbench for @nonoun/native-ui — JSONL editor, kernel preview, and protocol inspector",
  "license": "MIT",
  "type": "module",
  "main": "./dist/native-a2ui.js",
  "module": "./dist/native-a2ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/native-a2ui.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./css": "./dist/native-a2ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "peerDependencies": {
    "@nonoun/native-ui": ">=0.5.0"
  },
  "dependencies": {
    "@nonoun/native-codemirror": "^0.2.0",
    "@codemirror/lang-json": "^6.0.0"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:types",
    "build:js": "vite build",
    "build:css": "cp src/css/a2ui.css dist/native-a2ui.css",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
