{
  "name": "@nonoun/native-data-viz",
  "version": "0.2.1",
  "description": "SVG charting & data visualization components for @nonoun/native-ui",
  "license": "MIT",
  "type": "module",
  "main": "./dist/native-data-viz.js",
  "module": "./dist/native-data-viz.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/native-data-viz.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./css": "./dist/native-data-viz.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "peerDependencies": {
    "@nonoun/native-ui": ">=0.7.0"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:types",
    "build:js": "vite build",
    "build:css": "cp src/css/chart.css dist/native-data-viz.css",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
