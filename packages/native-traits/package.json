{
  "name": "@nonoun/native-traits",
  "version": "0.1.15",
  "description": "Composable trait controllers for @nonoun/native-ui — press, drag, resize, popover, and 30+ more behaviors",
  "license": "MIT",
  "type": "module",
  "main": "./dist/native-traits.js",
  "module": "./dist/native-traits.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/native-traits.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "peerDependencies": {
    "@nonoun/native-core": ">=0.1.0"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "vite build && vite build --config vite.config.register.ts",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
