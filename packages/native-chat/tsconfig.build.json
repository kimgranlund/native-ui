{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@nonoun/native-ui": ["../../node_modules/@nonoun/native-ui/dist/src/index.d.ts"]
    }
  },
  "exclude": ["src/**/*.test.ts"]
}
