{
  "id": "wizard-stepper",
  "label": "Wizard Stepper",
  "tier": "block",
  "concepts": ["wizard", "stepper", "multi-step", "onboarding"],
  "description": "Multi-step wizard with numbered step indicators in the header, form fields in the body, and back/continue navigation in the footer.",
  "category": "form",
  "temperature": 0.4,
  "components": [
    { "id": "root", "component": "Card", "children": ["header", "body", "footer"] },
    { "id": "header", "component": "Header", "children": ["steps-row"] },
    { "id": "steps-row", "component": "Row", "children": ["step-1-col", "step-2-col", "step-3-col"], "properties": { "gap": "lg", "justify": "center", "align": "center" } },
    { "id": "step-1-col", "component": "Row", "children": ["step-1-badge", "step-1-label"], "properties": { "gap": "xs", "align": "center" } },
    { "id": "step-1-badge", "component": "Badge", "text": "1", "properties": { "intent": "primary" } },
    { "id": "step-1-label", "component": "Text", "text": "Account", "properties": { "weight": "medium", "size": "sm" } },
    { "id": "step-2-col", "component": "Row", "children": ["step-2-badge", "step-2-label"], "properties": { "gap": "xs", "align": "center" } },
    { "id": "step-2-badge", "component": "Badge", "text": "2" },
    { "id": "step-2-label", "component": "Text", "text": "Profile", "properties": { "muted": true, "size": "sm" } },
    { "id": "step-3-col", "component": "Row", "children": ["step-3-badge", "step-3-label"], "properties": { "gap": "xs", "align": "center" } },
    { "id": "step-3-badge", "component": "Badge", "text": "3" },
    { "id": "step-3-label", "component": "Text", "text": "Review", "properties": { "muted": true, "size": "sm" } },
    { "id": "body", "component": "Body", "child": "form-col" },
    { "id": "form-col", "component": "Column", "children": ["step-title", "email-label", "email-input", "password-label", "password-input"], "properties": { "gap": "md" } },
    { "id": "step-title", "component": "Text", "text": "Step 1: Create Account", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "email-label", "component": "Text", "text": "Email", "properties": { "size": "sm", "weight": "medium" } },
    { "id": "email-input", "component": "TextField", "properties": { "placeholder": "you@example.com", "type": "email" } },
    { "id": "password-label", "component": "Text", "text": "Password", "properties": { "size": "sm", "weight": "medium" } },
    { "id": "password-input", "component": "TextField", "properties": { "placeholder": "Create a password", "type": "password" } },
    { "id": "footer", "component": "Footer", "children": ["actions-row"] },
    { "id": "actions-row", "component": "Row", "children": ["back-btn", "continue-btn"], "properties": { "justify": "space-between" } },
    { "id": "back-btn", "component": "Button", "text": "Back", "variant": "outline", "properties": { "disabled": true } },
    { "id": "continue-btn", "component": "Button", "text": "Continue", "variant": "primary" }
  ],
  "composedOf": ["form-field", "button-pair"]
}
