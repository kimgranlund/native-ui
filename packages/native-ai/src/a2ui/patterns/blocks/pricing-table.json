{
  "id": "pricing-table",
  "label": "Pricing Table",
  "tier": "block",
  "concepts": ["pricing", "plans", "subscription", "tiers"],
  "description": "Side-by-side pricing plan cards with tier name, price, features, and CTA.",
  "category": "commerce",
  "components": [
    { "id": "root", "component": "Row", "children": ["plan-basic", "plan-pro", "plan-enterprise"], "properties": { "gap": "md", "align": "stretch" } },
    { "id": "plan-basic", "component": "Card", "children": ["header-basic", "body-basic", "footer-basic"] },
    { "id": "header-basic", "component": "Header", "children": ["title-basic"] },
    { "id": "title-basic", "component": "Text", "text": "Basic", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "body-basic", "component": "Body", "child": "col-basic" },
    { "id": "col-basic", "component": "Column", "children": ["price-basic", "features-basic"], "properties": { "gap": "md" } },
    { "id": "price-basic", "component": "Text", "text": "$9/mo", "properties": { "size": "xl", "weight": "bold" } },
    { "id": "features-basic", "component": "List", "children": ["feat-basic-1", "feat-basic-2", "feat-basic-3"] },
    { "id": "feat-basic-1", "component": "ListItem", "text": "5 projects" },
    { "id": "feat-basic-2", "component": "ListItem", "text": "1 GB storage" },
    { "id": "feat-basic-3", "component": "ListItem", "text": "Email support" },
    { "id": "footer-basic", "component": "Footer", "children": ["cta-basic"] },
    { "id": "cta-basic", "component": "Button", "text": "Choose Plan", "variant": "outline", "properties": { "full": true } },
    { "id": "plan-pro", "component": "Card", "children": ["header-pro", "body-pro", "footer-pro"] },
    { "id": "header-pro", "component": "Header", "children": ["title-pro", "badge-pro"] },
    { "id": "title-pro", "component": "Text", "text": "Pro", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "badge-pro", "component": "Badge", "text": "Recommended" },
    { "id": "body-pro", "component": "Body", "child": "col-pro" },
    { "id": "col-pro", "component": "Column", "children": ["price-pro", "features-pro"], "properties": { "gap": "md" } },
    { "id": "price-pro", "component": "Text", "text": "$29/mo", "properties": { "size": "xl", "weight": "bold" } },
    { "id": "features-pro", "component": "List", "children": ["feat-pro-1", "feat-pro-2", "feat-pro-3"] },
    { "id": "feat-pro-1", "component": "ListItem", "text": "Unlimited projects" },
    { "id": "feat-pro-2", "component": "ListItem", "text": "50 GB storage" },
    { "id": "feat-pro-3", "component": "ListItem", "text": "Priority support" },
    { "id": "footer-pro", "component": "Footer", "children": ["cta-pro"] },
    { "id": "cta-pro", "component": "Button", "text": "Choose Plan", "variant": "primary", "properties": { "full": true } },
    { "id": "plan-enterprise", "component": "Card", "children": ["header-ent", "body-ent", "footer-ent"] },
    { "id": "header-ent", "component": "Header", "children": ["title-ent"] },
    { "id": "title-ent", "component": "Text", "text": "Enterprise", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "body-ent", "component": "Body", "child": "col-ent" },
    { "id": "col-ent", "component": "Column", "children": ["price-ent", "features-ent"], "properties": { "gap": "md" } },
    { "id": "price-ent", "component": "Text", "text": "$99/mo", "properties": { "size": "xl", "weight": "bold" } },
    { "id": "features-ent", "component": "List", "children": ["feat-ent-1", "feat-ent-2", "feat-ent-3"] },
    { "id": "feat-ent-1", "component": "ListItem", "text": "Unlimited everything" },
    { "id": "feat-ent-2", "component": "ListItem", "text": "500 GB storage" },
    { "id": "feat-ent-3", "component": "ListItem", "text": "Dedicated support" },
    { "id": "footer-ent", "component": "Footer", "children": ["cta-ent"] },
    { "id": "cta-ent", "component": "Button", "text": "Choose Plan", "variant": "outline", "properties": { "full": true } }
  ],
  "composedOf": ["button-pair"]
}
