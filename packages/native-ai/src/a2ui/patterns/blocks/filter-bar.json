{
  "id": "filter-bar",
  "label": "Filter Bar",
  "tier": "block",
  "concepts": ["filter", "sort", "toolbar", "search"],
  "description": "Horizontal filter and sort bar with search field, category picker, date range inputs, sort selector, and action buttons.",
  "category": "data",
  "components": [
    { "id": "root", "component": "Row", "children": ["search-field", "category-picker", "from-date", "to-date", "sort-picker", "apply-btn", "clear-btn"], "properties": { "gap": "sm", "align": "end" } },
    { "id": "search-field", "component": "TextField", "properties": { "placeholder": "Search...", "type": "search" } },
    { "id": "category-picker", "component": "ChoicePicker", "properties": { "placeholder": "Category", "options": ["All", "Electronics", "Clothing", "Books", "Home"] } },
    { "id": "from-date", "component": "DateTimeInput", "properties": { "placeholder": "From date" } },
    { "id": "to-date", "component": "DateTimeInput", "properties": { "placeholder": "To date" } },
    { "id": "sort-picker", "component": "ChoicePicker", "properties": { "placeholder": "Sort by", "options": ["Newest", "Oldest", "Name A-Z", "Name Z-A", "Price"] } },
    { "id": "apply-btn", "component": "Button", "text": "Apply", "variant": "primary" },
    { "id": "clear-btn", "component": "Button", "text": "Clear", "variant": "ghost" }
  ],
  "composedOf": ["search-field"]
}
