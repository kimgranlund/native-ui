{
  "id": "shopping-cart",
  "label": "Shopping Cart",
  "tier": "block",
  "concepts": ["cart", "checkout", "order", "basket"],
  "description": "Shopping cart panel with item list, per-item remove actions, total, and checkout button.",
  "category": "commerce",
  "temperature": 0.6,
  "components": [
    { "id": "root", "component": "Card", "children": ["header", "body", "divider", "footer"] },
    { "id": "header", "component": "Header", "children": ["cart-title", "item-count"] },
    { "id": "cart-title", "component": "Text", "text": "Shopping Cart", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "item-count", "component": "Badge", "text": "3", "properties": { "intent": "primary" } },
    { "id": "body", "component": "Body", "child": "items-list" },
    { "id": "items-list", "component": "List", "children": ["item-1", "item-2"] },
    { "id": "item-1", "component": "Row", "children": ["item-1-img", "item-1-info", "item-1-remove"], "properties": { "gap": "md", "align": "center" } },
    { "id": "item-1-img", "component": "Image", "properties": { "src": "https://placehold.co/64x64", "alt": "Wireless Headphones", "width": "64", "height": "64" } },
    { "id": "item-1-info", "component": "Column", "children": ["item-1-name", "item-1-price"], "properties": { "gap": "xs" } },
    { "id": "item-1-name", "component": "Text", "text": "Wireless Headphones", "properties": { "weight": "medium" } },
    { "id": "item-1-price", "component": "Text", "text": "$79.99", "properties": { "muted": true, "size": "sm" } },
    { "id": "item-1-remove", "component": "Button", "text": "Remove", "variant": "ghost", "properties": { "size": "sm", "intent": "danger" } },
    { "id": "item-2", "component": "Row", "children": ["item-2-img", "item-2-info", "item-2-remove"], "properties": { "gap": "md", "align": "center" } },
    { "id": "item-2-img", "component": "Image", "properties": { "src": "https://placehold.co/64x64", "alt": "Phone Case", "width": "64", "height": "64" } },
    { "id": "item-2-info", "component": "Column", "children": ["item-2-name", "item-2-price"], "properties": { "gap": "xs" } },
    { "id": "item-2-name", "component": "Text", "text": "Phone Case", "properties": { "weight": "medium" } },
    { "id": "item-2-price", "component": "Text", "text": "$24.99", "properties": { "muted": true, "size": "sm" } },
    { "id": "item-2-remove", "component": "Button", "text": "Remove", "variant": "ghost", "properties": { "size": "sm", "intent": "danger" } },
    { "id": "divider", "component": "Divider" },
    { "id": "footer", "component": "Footer", "children": ["footer-row"] },
    { "id": "footer-row", "component": "Row", "children": ["total-text", "checkout-btn"], "properties": { "justify": "space-between", "align": "center" } },
    { "id": "total-text", "component": "Text", "text": "Total: $104.98", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "checkout-btn", "component": "Button", "text": "Checkout", "variant": "primary" }
  ],
  "composedOf": ["list-item-action"]
}
