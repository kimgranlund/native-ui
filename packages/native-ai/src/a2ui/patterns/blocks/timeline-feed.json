{
  "id": "timeline-feed",
  "label": "Timeline Feed",
  "tier": "block",
  "concepts": ["timeline", "activity", "feed", "history"],
  "description": "Activity timeline with event icons, descriptions, timestamps, and a load-more action.",
  "category": "communication",
  "components": [
    { "id": "root", "component": "Card", "children": ["header", "body", "footer"] },
    { "id": "header", "component": "Header", "children": ["title"] },
    { "id": "title", "component": "Text", "text": "Activity", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "body", "component": "Body", "child": "events-list" },
    { "id": "events-list", "component": "List", "children": ["event-1", "event-2", "event-3", "event-4"] },
    { "id": "event-1", "component": "ListItem", "text": "" },
    { "id": "event-1-row", "component": "Row", "children": ["icon-1", "event-1-col"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "icon-1", "component": "Icon", "properties": { "name": "check-circle" } },
    { "id": "event-1-col", "component": "Column", "children": ["event-1-desc", "event-1-time"], "properties": { "gap": "xs" } },
    { "id": "event-1-desc", "component": "Text", "text": "Deployment completed successfully" },
    { "id": "event-1-time", "component": "Text", "text": "10 minutes ago", "properties": { "muted": true, "size": "sm" } },
    { "id": "event-2", "component": "ListItem", "text": "" },
    { "id": "event-2-row", "component": "Row", "children": ["icon-2", "event-2-col"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "icon-2", "component": "Icon", "properties": { "name": "pencil" } },
    { "id": "event-2-col", "component": "Column", "children": ["event-2-desc", "event-2-time"], "properties": { "gap": "xs" } },
    { "id": "event-2-desc", "component": "Text", "text": "Config file updated by admin" },
    { "id": "event-2-time", "component": "Text", "text": "1 hour ago", "properties": { "muted": true, "size": "sm" } },
    { "id": "event-3", "component": "ListItem", "text": "" },
    { "id": "event-3-row", "component": "Row", "children": ["icon-3", "event-3-col"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "icon-3", "component": "Icon", "properties": { "name": "user-plus" } },
    { "id": "event-3-col", "component": "Column", "children": ["event-3-desc", "event-3-time"], "properties": { "gap": "xs" } },
    { "id": "event-3-desc", "component": "Text", "text": "New team member joined: Sarah" },
    { "id": "event-3-time", "component": "Text", "text": "3 hours ago", "properties": { "muted": true, "size": "sm" } },
    { "id": "event-4", "component": "ListItem", "text": "" },
    { "id": "event-4-row", "component": "Row", "children": ["icon-4", "event-4-col"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "icon-4", "component": "Icon", "properties": { "name": "warning" } },
    { "id": "event-4-col", "component": "Column", "children": ["event-4-desc", "event-4-time"], "properties": { "gap": "xs" } },
    { "id": "event-4-desc", "component": "Text", "text": "API rate limit threshold reached" },
    { "id": "event-4-time", "component": "Text", "text": "Yesterday", "properties": { "muted": true, "size": "sm" } },
    { "id": "footer", "component": "Footer", "children": ["load-more"] },
    { "id": "load-more", "component": "Button", "text": "Load More", "variant": "ghost", "properties": { "full": true } }
  ],
  "composedOf": ["icon-text-row"]
}
