{
  "id": "search-results",
  "label": "Search Results",
  "tier": "block",
  "concepts": ["search", "results", "filter", "browse"],
  "description": "Search page with query field, sort picker, and a list of result cards with metadata.",
  "category": "data",
  "components": [
    { "id": "root", "component": "Column", "children": ["search-bar", "results-list"], "properties": { "gap": "md" } },
    { "id": "search-bar", "component": "Row", "children": ["search-field", "sort-picker"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "search-field", "component": "TextField", "properties": { "placeholder": "Search...", "icon": "magnifying-glass" } },
    { "id": "sort-picker", "component": "ChoicePicker", "properties": { "label": "Sort by" } },
    { "id": "results-list", "component": "List", "children": ["result-1", "result-2", "result-3"] },
    { "id": "result-1", "component": "Card", "children": ["body-1"] },
    { "id": "body-1", "component": "Body", "child": "col-1" },
    { "id": "col-1", "component": "Column", "children": ["row-title-1", "desc-1", "meta-1"], "properties": { "gap": "sm" } },
    { "id": "row-title-1", "component": "Row", "children": ["title-1", "badge-1"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "title-1", "component": "Text", "text": "Building Scalable APIs", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "badge-1", "component": "Badge", "text": "Engineering" },
    { "id": "desc-1", "component": "Text", "text": "A comprehensive guide to designing RESTful APIs that scale gracefully under load." },
    { "id": "meta-1", "component": "Row", "children": ["icon-date-1", "date-1", "icon-views-1", "views-1"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "icon-date-1", "component": "Icon", "properties": { "name": "clock" } },
    { "id": "date-1", "component": "Text", "text": "Mar 8, 2026", "properties": { "muted": true, "size": "sm" } },
    { "id": "icon-views-1", "component": "Icon", "properties": { "name": "eye" } },
    { "id": "views-1", "component": "Text", "text": "2.4K views", "properties": { "muted": true, "size": "sm" } },
    { "id": "result-2", "component": "Card", "children": ["body-2"] },
    { "id": "body-2", "component": "Body", "child": "col-2" },
    { "id": "col-2", "component": "Column", "children": ["row-title-2", "desc-2", "meta-2"], "properties": { "gap": "sm" } },
    { "id": "row-title-2", "component": "Row", "children": ["title-2", "badge-2"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "title-2", "component": "Text", "text": "CSS Custom Properties Deep Dive", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "badge-2", "component": "Badge", "text": "Frontend" },
    { "id": "desc-2", "component": "Text", "text": "Explore advanced patterns for using CSS custom properties in design systems and theming." },
    { "id": "meta-2", "component": "Row", "children": ["icon-date-2", "date-2", "icon-views-2", "views-2"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "icon-date-2", "component": "Icon", "properties": { "name": "clock" } },
    { "id": "date-2", "component": "Text", "text": "Mar 5, 2026", "properties": { "muted": true, "size": "sm" } },
    { "id": "icon-views-2", "component": "Icon", "properties": { "name": "eye" } },
    { "id": "views-2", "component": "Text", "text": "1.8K views", "properties": { "muted": true, "size": "sm" } },
    { "id": "result-3", "component": "Card", "children": ["body-3"] },
    { "id": "body-3", "component": "Body", "child": "col-3" },
    { "id": "col-3", "component": "Column", "children": ["row-title-3", "desc-3", "meta-3"], "properties": { "gap": "sm" } },
    { "id": "row-title-3", "component": "Row", "children": ["title-3", "badge-3"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "title-3", "component": "Text", "text": "Web Components in 2026", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "badge-3", "component": "Badge", "text": "Standards" },
    { "id": "desc-3", "component": "Text", "text": "The state of web components: what's changed, what works, and what's next for the platform." },
    { "id": "meta-3", "component": "Row", "children": ["icon-date-3", "date-3", "icon-views-3", "views-3"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "icon-date-3", "component": "Icon", "properties": { "name": "clock" } },
    { "id": "date-3", "component": "Text", "text": "Feb 28, 2026", "properties": { "muted": true, "size": "sm" } },
    { "id": "icon-views-3", "component": "Icon", "properties": { "name": "eye" } },
    { "id": "views-3", "component": "Text", "text": "3.1K views", "properties": { "muted": true, "size": "sm" } }
  ],
  "composedOf": ["search-field"]
}
