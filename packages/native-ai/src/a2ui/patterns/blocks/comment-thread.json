{
  "id": "comment-thread",
  "label": "Comment Thread",
  "tier": "block",
  "concepts": ["comments", "discussion", "replies", "feedback"],
  "description": "Comments section with user avatars, timestamps, reply/like actions, and a compose area.",
  "category": "communication",
  "temperature": 0.6,
  "components": [
    { "id": "root", "component": "Card", "children": ["header", "body", "footer"] },
    { "id": "header", "component": "Header", "children": ["title", "count-badge"] },
    { "id": "title", "component": "Text", "text": "Comments", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "count-badge", "component": "Badge", "text": "12" },
    { "id": "body", "component": "Body", "child": "comments-list" },
    { "id": "comments-list", "component": "List", "children": ["comment-1", "comment-2"] },
    { "id": "comment-1", "component": "ListItem", "text": "" },
    { "id": "comment-1-row", "component": "Row", "children": ["avatar-1", "comment-1-col"], "properties": { "gap": "sm", "align": "start" } },
    { "id": "avatar-1", "component": "Avatar", "properties": { "name": "Sarah Chen" } },
    { "id": "comment-1-col", "component": "Column", "children": ["comment-1-meta", "comment-1-body", "comment-1-actions"], "properties": { "gap": "xs" } },
    { "id": "comment-1-meta", "component": "Row", "children": ["author-1", "time-1"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "author-1", "component": "Text", "text": "Sarah Chen", "properties": { "weight": "medium" } },
    { "id": "time-1", "component": "Text", "text": "2 hours ago", "properties": { "muted": true, "size": "sm" } },
    { "id": "comment-1-body", "component": "Text", "text": "This is a fantastic approach to component design. The token system really simplifies theming." },
    { "id": "comment-1-actions", "component": "Row", "children": ["reply-1", "like-1"], "properties": { "gap": "sm" } },
    { "id": "reply-1", "component": "Button", "text": "Reply", "variant": "ghost", "properties": { "size": "sm" } },
    { "id": "like-1", "component": "Button", "text": "Like", "variant": "ghost", "properties": { "size": "sm" } },
    { "id": "comment-2", "component": "ListItem", "text": "" },
    { "id": "comment-2-row", "component": "Row", "children": ["avatar-2", "comment-2-col"], "properties": { "gap": "sm", "align": "start" } },
    { "id": "avatar-2", "component": "Avatar", "properties": { "name": "Marcus Rivera" } },
    { "id": "comment-2-col", "component": "Column", "children": ["comment-2-meta", "comment-2-body", "comment-2-actions"], "properties": { "gap": "xs" } },
    { "id": "comment-2-meta", "component": "Row", "children": ["author-2", "time-2"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "author-2", "component": "Text", "text": "Marcus Rivera", "properties": { "weight": "medium" } },
    { "id": "time-2", "component": "Text", "text": "5 hours ago", "properties": { "muted": true, "size": "sm" } },
    { "id": "comment-2-body", "component": "Text", "text": "Agreed! I especially like how the CSS layers handle specificity without any hacks." },
    { "id": "comment-2-actions", "component": "Row", "children": ["reply-2", "like-2"], "properties": { "gap": "sm" } },
    { "id": "reply-2", "component": "Button", "text": "Reply", "variant": "ghost", "properties": { "size": "sm" } },
    { "id": "like-2", "component": "Button", "text": "Like", "variant": "ghost", "properties": { "size": "sm" } },
    { "id": "footer", "component": "Footer", "children": ["compose-row"] },
    { "id": "compose-row", "component": "Row", "children": ["compose-input", "post-btn"], "properties": { "gap": "sm", "align": "end" } },
    { "id": "compose-input", "component": "TextArea", "properties": { "placeholder": "Write a comment..." } },
    { "id": "post-btn", "component": "Button", "text": "Post", "variant": "primary" }
  ],
  "composedOf": ["avatar-row"]
}
