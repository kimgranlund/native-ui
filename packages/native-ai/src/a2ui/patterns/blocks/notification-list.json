{
  "id": "notification-list",
  "label": "Notification List",
  "tier": "block",
  "concepts": ["notifications", "alerts", "inbox", "activity"],
  "description": "Notification panel with badge count, dismissible notification items, and mark-all-read action.",
  "category": "communication",
  "components": [
    { "id": "root", "component": "Card", "children": ["header", "body", "footer"] },
    { "id": "header", "component": "Header", "children": ["header-row"] },
    { "id": "header-row", "component": "Row", "children": ["notif-title", "notif-count"], "properties": { "justify": "space-between", "align": "center" } },
    { "id": "notif-title", "component": "Text", "text": "Notifications", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "notif-count", "component": "Badge", "text": "3", "properties": { "intent": "danger" } },
    { "id": "body", "component": "Body", "child": "notif-list" },
    { "id": "notif-list", "component": "List", "children": ["notif-1", "notif-2", "notif-3"] },
    { "id": "notif-1", "component": "Row", "children": ["n1-icon", "n1-content", "n1-dismiss"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "n1-icon", "component": "Icon", "properties": { "name": "chat-circle", "intent": "primary" } },
    { "id": "n1-content", "component": "Column", "children": ["n1-title", "n1-time"], "properties": { "gap": "xs" } },
    { "id": "n1-title", "component": "Text", "text": "New comment on your post", "properties": { "size": "sm", "weight": "medium" } },
    { "id": "n1-time", "component": "Text", "text": "2 minutes ago", "properties": { "size": "xs", "muted": true } },
    { "id": "n1-dismiss", "component": "Button", "text": "Dismiss", "variant": "ghost", "properties": { "size": "sm" } },
    { "id": "notif-2", "component": "Row", "children": ["n2-icon", "n2-content", "n2-dismiss"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "n2-icon", "component": "Icon", "properties": { "name": "user-plus", "intent": "success" } },
    { "id": "n2-content", "component": "Column", "children": ["n2-title", "n2-time"], "properties": { "gap": "xs" } },
    { "id": "n2-title", "component": "Text", "text": "Alex started following you", "properties": { "size": "sm", "weight": "medium" } },
    { "id": "n2-time", "component": "Text", "text": "1 hour ago", "properties": { "size": "xs", "muted": true } },
    { "id": "n2-dismiss", "component": "Button", "text": "Dismiss", "variant": "ghost", "properties": { "size": "sm" } },
    { "id": "notif-3", "component": "Row", "children": ["n3-icon", "n3-content", "n3-dismiss"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "n3-icon", "component": "Icon", "properties": { "name": "warning", "intent": "warning" } },
    { "id": "n3-content", "component": "Column", "children": ["n3-title", "n3-time"], "properties": { "gap": "xs" } },
    { "id": "n3-title", "component": "Text", "text": "Storage usage at 90%", "properties": { "size": "sm", "weight": "medium" } },
    { "id": "n3-time", "component": "Text", "text": "3 hours ago", "properties": { "size": "xs", "muted": true } },
    { "id": "n3-dismiss", "component": "Button", "text": "Dismiss", "variant": "ghost", "properties": { "size": "sm" } },
    { "id": "footer", "component": "Footer", "children": ["mark-all-btn"] },
    { "id": "mark-all-btn", "component": "Button", "text": "Mark all as read", "variant": "ghost", "properties": { "full": true } }
  ],
  "composedOf": ["icon-text-row"]
}
