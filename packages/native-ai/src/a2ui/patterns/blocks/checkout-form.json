{
  "id": "checkout-form",
  "label": "Checkout Form",
  "tier": "block",
  "concepts": ["checkout", "payment", "billing", "order"],
  "description": "Payment form with shipping and billing sections, field groups, and order total.",
  "category": "commerce",
  "temperature": 0.6,
  "components": [
    { "id": "root", "component": "Card", "children": ["header", "body", "footer"] },
    { "id": "header", "component": "Header", "children": ["title"] },
    { "id": "title", "component": "Text", "text": "Checkout", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "body", "component": "Body", "child": "form-col" },
    { "id": "form-col", "component": "Column", "children": ["shipping-title", "name-row", "address-field", "city-row", "divider-1", "payment-title", "card-field", "card-details-row"], "properties": { "gap": "md" } },
    { "id": "shipping-title", "component": "Text", "text": "Shipping", "properties": { "size": "md", "weight": "bold" } },
    { "id": "name-row", "component": "Row", "children": ["first-name", "last-name"], "properties": { "gap": "sm" } },
    { "id": "first-name", "component": "TextField", "properties": { "placeholder": "First name" } },
    { "id": "last-name", "component": "TextField", "properties": { "placeholder": "Last name" } },
    { "id": "address-field", "component": "TextField", "properties": { "placeholder": "Address" } },
    { "id": "city-row", "component": "Row", "children": ["city-field", "zip-field"], "properties": { "gap": "sm" } },
    { "id": "city-field", "component": "TextField", "properties": { "placeholder": "City" } },
    { "id": "zip-field", "component": "TextField", "properties": { "placeholder": "ZIP code" } },
    { "id": "divider-1", "component": "Divider" },
    { "id": "payment-title", "component": "Text", "text": "Payment", "properties": { "size": "md", "weight": "bold" } },
    { "id": "card-field", "component": "TextField", "properties": { "placeholder": "Card number" } },
    { "id": "card-details-row", "component": "Row", "children": ["expiry-field", "cvv-field"], "properties": { "gap": "sm" } },
    { "id": "expiry-field", "component": "TextField", "properties": { "placeholder": "MM / YY" } },
    { "id": "cvv-field", "component": "TextField", "properties": { "placeholder": "CVV" } },
    { "id": "footer", "component": "Footer", "children": ["footer-row"] },
    { "id": "footer-row", "component": "Row", "children": ["total-col", "place-order"], "properties": { "justify": "space-between", "align": "center" } },
    { "id": "total-col", "component": "Column", "children": ["total-label", "total-amount"], "properties": { "gap": "xs" } },
    { "id": "total-label", "component": "Text", "text": "Total", "properties": { "muted": true, "size": "sm" } },
    { "id": "total-amount", "component": "Text", "text": "$99.00", "properties": { "size": "xl", "weight": "bold" } },
    { "id": "place-order", "component": "Button", "text": "Place Order", "variant": "primary" }
  ],
  "composedOf": ["form-field", "button-pair"]
}
