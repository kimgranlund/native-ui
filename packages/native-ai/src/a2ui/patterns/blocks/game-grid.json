{
  "id": "game-grid",
  "label": "Game Grid",
  "tier": "block",
  "concepts": ["game", "grid", "tic-tac-toe", "board"],
  "description": "Tic-tac-toe style game board with a 3x3 button grid, turn indicator badge, score display, and new game action.",
  "category": "interactive",
  "temperature": 0.7,
  "components": [
    { "id": "root", "component": "Card", "children": ["header", "body", "footer"] },
    { "id": "header", "component": "Header", "children": ["header-row"] },
    { "id": "header-row", "component": "Row", "children": ["title", "turn-badge"], "properties": { "justify": "space-between", "align": "center" } },
    { "id": "title", "component": "Text", "text": "Tic-Tac-Toe", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "turn-badge", "component": "Badge", "text": "Your turn", "properties": { "intent": "primary" } },
    { "id": "body", "component": "Body", "child": "grid-col" },
    { "id": "grid-col", "component": "Column", "children": ["row-1", "row-2", "row-3"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "row-1", "component": "Row", "children": ["cell-1-1", "cell-1-2", "cell-1-3"], "properties": { "gap": "sm" } },
    { "id": "cell-1-1", "component": "Button", "text": "X", "variant": "outline", "properties": { "size": "lg" } },
    { "id": "cell-1-2", "component": "Button", "text": " ", "variant": "outline", "properties": { "size": "lg" } },
    { "id": "cell-1-3", "component": "Button", "text": "O", "variant": "outline", "properties": { "size": "lg" } },
    { "id": "row-2", "component": "Row", "children": ["cell-2-1", "cell-2-2", "cell-2-3"], "properties": { "gap": "sm" } },
    { "id": "cell-2-1", "component": "Button", "text": " ", "variant": "outline", "properties": { "size": "lg" } },
    { "id": "cell-2-2", "component": "Button", "text": "X", "variant": "outline", "properties": { "size": "lg" } },
    { "id": "cell-2-3", "component": "Button", "text": " ", "variant": "outline", "properties": { "size": "lg" } },
    { "id": "row-3", "component": "Row", "children": ["cell-3-1", "cell-3-2", "cell-3-3"], "properties": { "gap": "sm" } },
    { "id": "cell-3-1", "component": "Button", "text": "O", "variant": "outline", "properties": { "size": "lg" } },
    { "id": "cell-3-2", "component": "Button", "text": " ", "variant": "outline", "properties": { "size": "lg" } },
    { "id": "cell-3-3", "component": "Button", "text": "X", "variant": "outline", "properties": { "size": "lg" } },
    { "id": "footer", "component": "Footer", "children": ["footer-row"] },
    { "id": "footer-row", "component": "Row", "children": ["score-text", "new-game-btn"], "properties": { "justify": "space-between", "align": "center" } },
    { "id": "score-text", "component": "Text", "text": "Score: X = 2, O = 1", "properties": { "muted": true } },
    { "id": "new-game-btn", "component": "Button", "text": "New Game", "variant": "primary" }
  ],
  "composedOf": ["button-pair"]
}
