{
  "id": "chat-conversation",
  "label": "Chat Conversation",
  "tier": "block",
  "concepts": ["chat", "messaging", "conversation", "dialogue"],
  "description": "Chat UI with user presence header, a scrollable message list with alternating sent/received messages, and a compose footer.",
  "category": "communication",
  "components": [
    { "id": "root", "component": "Card", "children": ["header", "body", "footer"] },
    { "id": "header", "component": "Header", "children": ["header-row"] },
    { "id": "header-row", "component": "Row", "children": ["user-avatar", "user-info-col"], "properties": { "gap": "sm", "align": "center" } },
    { "id": "user-avatar", "component": "Avatar", "properties": { "name": "Alex Chen", "size": "sm" } },
    { "id": "user-info-col", "component": "Column", "children": ["user-name", "user-status"], "properties": { "gap": "xs" } },
    { "id": "user-name", "component": "Text", "text": "Alex Chen", "properties": { "weight": "medium" } },
    { "id": "user-status", "component": "Text", "text": "Online", "properties": { "muted": true, "size": "sm", "intent": "success" } },
    { "id": "body", "component": "Body", "child": "messages-list" },
    { "id": "messages-list", "component": "List", "children": ["msg-1", "msg-2", "msg-3"] },
    { "id": "msg-1", "component": "Row", "children": ["msg-1-avatar", "msg-1-col"], "properties": { "gap": "sm", "align": "start" } },
    { "id": "msg-1-avatar", "component": "Avatar", "properties": { "name": "Alex Chen", "size": "sm" } },
    { "id": "msg-1-col", "component": "Column", "children": ["msg-1-text", "msg-1-time"], "properties": { "gap": "xs" } },
    { "id": "msg-1-text", "component": "Text", "text": "Hey! Are you free for a quick call this afternoon?" },
    { "id": "msg-1-time", "component": "Text", "text": "2:30 PM", "properties": { "muted": true, "size": "sm" } },
    { "id": "msg-2", "component": "Row", "children": ["msg-2-col", "msg-2-avatar"], "properties": { "gap": "sm", "align": "start", "justify": "end" } },
    { "id": "msg-2-col", "component": "Column", "children": ["msg-2-text", "msg-2-time"], "properties": { "gap": "xs", "align": "end" } },
    { "id": "msg-2-text", "component": "Text", "text": "Sure, I'm available after 3. Let me know when works." },
    { "id": "msg-2-time", "component": "Text", "text": "2:32 PM", "properties": { "muted": true, "size": "sm" } },
    { "id": "msg-2-avatar", "component": "Avatar", "properties": { "name": "You", "size": "sm" } },
    { "id": "msg-3", "component": "Row", "children": ["msg-3-avatar", "msg-3-col"], "properties": { "gap": "sm", "align": "start" } },
    { "id": "msg-3-avatar", "component": "Avatar", "properties": { "name": "Alex Chen", "size": "sm" } },
    { "id": "msg-3-col", "component": "Column", "children": ["msg-3-text", "msg-3-time"], "properties": { "gap": "xs" } },
    { "id": "msg-3-text", "component": "Text", "text": "Perfect, I'll send the invite for 3:15. Talk soon!" },
    { "id": "msg-3-time", "component": "Text", "text": "2:33 PM", "properties": { "muted": true, "size": "sm" } },
    { "id": "footer", "component": "Footer", "children": ["compose-row"] },
    { "id": "compose-row", "component": "Row", "children": ["message-input", "send-btn"], "properties": { "gap": "sm", "align": "end" } },
    { "id": "message-input", "component": "TextArea", "properties": { "placeholder": "Type a message...", "rows": 1 } },
    { "id": "send-btn", "component": "Button", "text": "Send", "variant": "primary" }
  ],
  "composedOf": ["avatar-row"]
}
