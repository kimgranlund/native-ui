{
  "id": "metric-dashboard",
  "label": "Metric Dashboard",
  "tier": "block",
  "concepts": ["KPI", "analytics", "stats", "metrics"],
  "description": "Four metric cards arranged in a 2x2 grid, each showing a large number, label, and trend indicator.",
  "category": "dashboard",
  "components": [
    { "id": "root", "component": "Column", "children": ["top-row", "bottom-row"], "properties": { "gap": "md" } },
    { "id": "top-row", "component": "Row", "children": ["metric-1", "metric-2"], "properties": { "gap": "md" } },
    { "id": "bottom-row", "component": "Row", "children": ["metric-3", "metric-4"], "properties": { "gap": "md" } },
    { "id": "metric-1", "component": "Card", "children": ["m1-col"] },
    { "id": "m1-col", "component": "Column", "children": ["m1-value", "m1-label", "m1-trend"], "properties": { "gap": "xs" } },
    { "id": "m1-value", "component": "Text", "text": "12,847", "properties": { "size": "2xl", "weight": "bold" } },
    { "id": "m1-label", "component": "Text", "text": "Total Users", "properties": { "muted": true, "size": "sm" } },
    { "id": "m1-trend", "component": "Row", "children": ["m1-trend-icon", "m1-trend-badge"], "properties": { "gap": "xs", "align": "center" } },
    { "id": "m1-trend-icon", "component": "Icon", "properties": { "name": "trend-up", "intent": "success" } },
    { "id": "m1-trend-badge", "component": "Badge", "text": "+12%", "properties": { "intent": "success" } },
    { "id": "metric-2", "component": "Card", "children": ["m2-col"] },
    { "id": "m2-col", "component": "Column", "children": ["m2-value", "m2-label", "m2-trend"], "properties": { "gap": "xs" } },
    { "id": "m2-value", "component": "Text", "text": "$48,290", "properties": { "size": "2xl", "weight": "bold" } },
    { "id": "m2-label", "component": "Text", "text": "Revenue", "properties": { "muted": true, "size": "sm" } },
    { "id": "m2-trend", "component": "Row", "children": ["m2-trend-icon", "m2-trend-badge"], "properties": { "gap": "xs", "align": "center" } },
    { "id": "m2-trend-icon", "component": "Icon", "properties": { "name": "trend-up", "intent": "success" } },
    { "id": "m2-trend-badge", "component": "Badge", "text": "+8.3%", "properties": { "intent": "success" } },
    { "id": "metric-3", "component": "Card", "children": ["m3-col"] },
    { "id": "m3-col", "component": "Column", "children": ["m3-value", "m3-label", "m3-trend"], "properties": { "gap": "xs" } },
    { "id": "m3-value", "component": "Text", "text": "3,642", "properties": { "size": "2xl", "weight": "bold" } },
    { "id": "m3-label", "component": "Text", "text": "Active Sessions", "properties": { "muted": true, "size": "sm" } },
    { "id": "m3-trend", "component": "Row", "children": ["m3-trend-icon", "m3-trend-badge"], "properties": { "gap": "xs", "align": "center" } },
    { "id": "m3-trend-icon", "component": "Icon", "properties": { "name": "trend-down", "intent": "danger" } },
    { "id": "m3-trend-badge", "component": "Badge", "text": "-2.1%", "properties": { "intent": "danger" } },
    { "id": "metric-4", "component": "Card", "children": ["m4-col"] },
    { "id": "m4-col", "component": "Column", "children": ["m4-value", "m4-label", "m4-trend"], "properties": { "gap": "xs" } },
    { "id": "m4-value", "component": "Text", "text": "98.7%", "properties": { "size": "2xl", "weight": "bold" } },
    { "id": "m4-label", "component": "Text", "text": "Uptime", "properties": { "muted": true, "size": "sm" } },
    { "id": "m4-trend", "component": "Row", "children": ["m4-trend-icon", "m4-trend-badge"], "properties": { "gap": "xs", "align": "center" } },
    { "id": "m4-trend-icon", "component": "Icon", "properties": { "name": "trend-up", "intent": "success" } },
    { "id": "m4-trend-badge", "component": "Badge", "text": "+0.2%", "properties": { "intent": "success" } }
  ],
  "composedOf": ["metric-tile"]
}
