{
  "id": "settings-form",
  "label": "Settings Form",
  "tier": "block",
  "concepts": ["preferences", "settings", "configuration", "profile"],
  "description": "Settings card with profile fields, notification toggles, and save/cancel actions.",
  "category": "form",
  "components": [
    { "id": "root", "component": "Card", "children": ["header", "body", "footer"] },
    { "id": "header", "component": "Header", "children": ["settings-title"] },
    { "id": "settings-title", "component": "Text", "text": "Settings", "properties": { "size": "xl", "weight": "bold" } },
    { "id": "body", "component": "Body", "child": "sections-col" },
    { "id": "sections-col", "component": "Column", "children": ["profile-heading", "name-label", "name-input", "email-label", "email-input", "bio-label", "bio-input", "divider-1", "notif-heading", "email-notif-row", "push-notif-row", "divider-2"], "properties": { "gap": "md" } },
    { "id": "profile-heading", "component": "Text", "text": "Profile", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "name-label", "component": "Text", "text": "Display Name", "properties": { "size": "sm", "weight": "medium" } },
    { "id": "name-input", "component": "TextField", "properties": { "placeholder": "Your display name" } },
    { "id": "email-label", "component": "Text", "text": "Email", "properties": { "size": "sm", "weight": "medium" } },
    { "id": "email-input", "component": "TextField", "properties": { "placeholder": "you@example.com", "type": "email" } },
    { "id": "bio-label", "component": "Text", "text": "Bio", "properties": { "size": "sm", "weight": "medium" } },
    { "id": "bio-input", "component": "TextArea", "properties": { "placeholder": "Tell us about yourself...", "rows": 3 } },
    { "id": "divider-1", "component": "Divider" },
    { "id": "notif-heading", "component": "Text", "text": "Notifications", "properties": { "size": "lg", "weight": "bold" } },
    { "id": "email-notif-row", "component": "Row", "children": ["email-notif-label", "email-notif-switch"], "properties": { "justify": "space-between", "align": "center" } },
    { "id": "email-notif-label", "component": "Text", "text": "Email notifications" },
    { "id": "email-notif-switch", "component": "Switch", "text": "", "properties": { "checked": true } },
    { "id": "push-notif-row", "component": "Row", "children": ["push-notif-label", "push-notif-switch"], "properties": { "justify": "space-between", "align": "center" } },
    { "id": "push-notif-label", "component": "Text", "text": "Push notifications" },
    { "id": "push-notif-switch", "component": "Switch", "text": "" },
    { "id": "divider-2", "component": "Divider" },
    { "id": "footer", "component": "Footer", "children": ["actions-row"] },
    { "id": "actions-row", "component": "Row", "children": ["cancel-btn", "save-btn"], "properties": { "gap": "sm", "justify": "flex-end" } },
    { "id": "cancel-btn", "component": "Button", "text": "Cancel", "variant": "outline" },
    { "id": "save-btn", "component": "Button", "text": "Save Changes", "variant": "primary" }
  ],
  "composedOf": ["form-field", "textarea-field", "switch-row", "button-pair"]
}
