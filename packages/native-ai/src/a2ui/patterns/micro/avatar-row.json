    { "id": "info", "component": "Column", "children": ["name", "role"], "properties": { "gap": "xs" } },
    { "id": "name", "component": "Text", "text": "Jane Doe", "properties": { "weight": "medium" } },
    { "id": "role", "component": "Text", "text": "Product Designer", "properties": { "muted": true, "size": "sm" } }
  ]
}
