{
  "id": "avatar-row",
  "label": "Avatar Row",
  "tier": "micro",
  "concepts": ["profile", "user", "identity"],
  "description": "Avatar + name + secondary text for user identity display.",
  "category": "primitive",
  "components": [
    { "id": "root", "component": "Row", "children": ["avatar", "info"], "properties": { "gap": "sm", "align": "center" } },
