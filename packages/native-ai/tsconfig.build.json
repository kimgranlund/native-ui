{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@nonoun/native-ui": ["../../dist/index.d.ts"],
      "@nonoun/native-kernel": ["../native-kernel/dist/index.d.ts"],
      "@nonoun/native-code": ["../native-code/dist/index.d.ts"],
      "@nonoun/native-code/register": ["../native-code/dist/register.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**", "src/**/*.demo.ts", "src/a2ui/builder/a2ui-builder.ts"]
}
