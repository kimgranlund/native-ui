{
  "name": "@nonoun/native-ai",
  "version": "1.0.36",
  "description": "AI components for @nonoun/native-ui — A2UI protocol adapter + chat input/message layout",
  "license": "MIT",
  "type": "module",
  "main": "./dist/native-ai.js",
  "module": "./dist/native-ai.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/native-ai.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    },
    "./css": "./dist/native-ai.css",
    "./adapters/direct": {
      "types": "./dist/a2ui/adapters/direct-adapter.d.ts",
      "default": "./dist/native-ai.js"
    },
    "./adapters/a2a": {
      "types": "./dist/a2ui/adapters/a2a-adapter.d.ts",
      "default": "./dist/native-ai.js"
    },
    "./adapters/ag-ui": {
      "types": "./dist/a2ui/adapters/ag-ui-adapter.d.ts",
      "default": "./dist/native-ai.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "peerDependencies": {
    "@nonoun/native-ui": ">=0.5.0",
    "@ag-ui/client": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@ag-ui/client": {
      "optional": true
    }
  },
  "dependencies": {
    "@nonoun/native-code": "^1.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lint": "^6.0.0"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:types",
    "build:js": "vite build && vite build --config vite.config.register.ts",
    "build:css": "cat src/a2ui/css/a2ui.css src/chat/chat.css > dist/native-ai.css",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
