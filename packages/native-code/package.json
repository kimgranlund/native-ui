{
  "name": "@nonoun/native-code",
  "version": "1.0.3",
  "description": "Code editing components for @nonoun/native-ui — CodeMirror integration, markdown editor, live playground",
  "license": "MIT",
  "type": "module",
  "main": "./dist/native-code.js",
  "module": "./dist/native-code.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/native-code.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./css": "./dist/native-code.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "peerDependencies": {
    "@nonoun/native-ui": ">=0.5.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.3.2"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:types",
    "build:js": "vite build",
    "build:css": "cat src/codemirror/css/codemirror.css src/editor/css/editor.css src/playground/css/playground.css > dist/native-code.css",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
